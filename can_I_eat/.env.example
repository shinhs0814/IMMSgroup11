# Anthropic API Key (get from console.anthropic.com)
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# Firebase Configuration (get from Firebase Console > Project Settings > Your Apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Food Safety Korea OpenAPI (foodsafetykorea.go.kr) — for Korean barcode lookup
# Get a free key at: https://www.foodsafetykorea.go.kr/apiMain.do
EXPO_PUBLIC_FOOD_SAFETY_KOREA_API_KEY=
